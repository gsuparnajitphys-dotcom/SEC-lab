   "source": [
    "def f(x,y):\n",
    "    return x+y\n",
    "\n",
    "# @ x=0 , y=0\n",
    "\n",
    "x=0\n",
    "y=1\n",
    "h=0.1 #step-size\n",
    "\n",
    "# I want to find y(0.3)\n",
    "\n",
    "#y_i+1=y_i+h*dy/dx \n",
    "#y_i+1=y_i+h*f(x,y)\n",
    "\n",
    "x_tgt=0.3\n",
    "\n",
    "while x<=x_tgt:\n",
    "    y+=h*f(x,y)\n",
    "    x+=h\n",
    "\n",
    "y"
   ]
  }
